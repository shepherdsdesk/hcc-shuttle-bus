{
  "rules": {
    "admins": {
      ".read": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      ".write": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      "$key": {
        ".validate": "newData.child('email').isString()"
      }
    },
    "pins": {
      ".read": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      ".write": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      "$pin": {
        ".read": "auth != null && root.child('drivers').child(auth.uid).child('pin').val() === $pin",
        ".validate": "$pin.matches(/^[0-9]{4,8}$/) && (newData.val() === true || newData.child('name').isString())"
      }
    },
    "drivers": {
      ".read": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      ".write": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.child('pin').isString() && newData.child('pin').val().matches(/^[0-9]{4,8}$/) && root.child('pins').child(newData.child('pin').val()).exists()"
      }
    },
    "live": {
      ".read": true,
      "$route": {
        "$bus": {
          ".write": "((auth != null && root.child('drivers').child(auth.uid).child('pin').exists() && root.child('pins').child(root.child('drivers').child(auth.uid).child('pin').val()).child('slot').val() === $route + '/' + $bus) && ($route === 'yatap' || $route === 'park') && $bus.matches(/^[1-9]$/)) || (((auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())) && !newData.exists())",
          ".validate": "!newData.exists() || (newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('ts').isNumber() && newData.child('uid').val() === auth.uid && newData.child('trip').isString())"
        }
      }
    },
    "logs": {
      ".read": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      ".write": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      "$date": {
        "$sid": {
          ".write": "((auth != null && root.child('drivers').child(auth.uid).child('pin').exists() && root.child('pins').child(root.child('drivers').child(auth.uid).child('pin').val()).exists())) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && newData.exists()))"
        }
      }
    },
    "board": {
      ".read": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      ".write": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      "$date": {
        "$route": {
          "$bus": {
            "$trip": {
              ".read": "(auth != null && root.child('drivers').child(auth.uid).child('pin').exists() && root.child('pins').child(root.child('drivers').child(auth.uid).child('pin').val()).exists())",
              "$uid": {
                ".read": "auth != null && auth.uid === $uid",
                ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('live').child($route).child($bus).child('trip').val() === $trip)",
                ".validate": "!newData.exists() || (newData.child('n').isNumber() && newData.child('n').val() >= 1 && newData.child('n').val() <= 9 && newData.child('ts').isNumber())"
              }
            }
          }
        }
      }
    },
    "wait": {
      ".read": "((auth != null && root.child('drivers').child(auth.uid).child('pin').exists() && root.child('pins').child(root.child('drivers').child(auth.uid).child('pin').val()).exists())) || ((auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists()))",
      ".write": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      "$route": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && ($route === 'yatap' || $route === 'park')",
          ".validate": "!newData.exists() || (newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('ts').isNumber())"
        }
      }
    },
    "waitc": {
      ".read": "auth != null",
      ".write": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      "$route": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($route === 'yatap' || $route === 'park')",
          ".validate": "!newData.exists() || (newData.child('s').isString() && newData.child('s').val().length <= 40 && newData.child('n').isNumber() && newData.child('n').val() >= 1 && newData.child('n').val() <= 9 && newData.child('ts').isNumber() && newData.child('lat').exists() == false && newData.child('lng').exists() == false)"
        }
      }
    },
    "config": {
      ".read": true,
      ".write": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())"
    },
    "tvmedia": {
      ".read": true,
      ".write": "(auth != null && auth.token.email != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
      "photo": {
        ".validate": "!newData.exists() || (newData.child('data').isString() && newData.child('data').val().beginsWith('data:image/') && newData.child('data').val().length < 700000)"
      }
    }
  }
}